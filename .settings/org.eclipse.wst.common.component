<?xml version="1.0" encoding="UTF-8"?>
<wb-project deploy-name="baiTapServlet">
    <wb-module deploy-path="/">
        <wb-resource deploy-path="/" source-path="/src/main/webapp" tag="defaultRootSource"/>
        <wb-resource deploy-path="/WEB-INF/classes" source-path="/src/main/java"/>
        <property name="context-root" value="baiTapServlet"/>
        <property name="java-output-path" value="/baiTapServlet/build/classes"/>
    </wb-module>
</wb-project>
